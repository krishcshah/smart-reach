# ─── SmartReach environment ────────────────────────────────────────────────
# Copy to apps/web/.env.local for the Next.js app
# Copy to packages/email-engine/.env for the background worker

# Database — Neon PostgreSQL (serverless HTTP driver; works locally & on Cloudflare)
#   Local dev  : postgres://postgres:postgres@localhost:5432/smartreach
#   Production : postgres://user:pass@host/db?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:5432/smartreach"

# Auth (Better Auth)
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Credential encryption — 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Engine tuning (used by packages/email-engine and any enqueue trigger)
ENGINE_INTERVAL_MS="30000"      # how often the scheduler enqueues new sends
ENGINE_SYNC_MS="120000"         # how often IMAP reply checks run
ENGINE_BATCH_SIZE="25"          # emails processed per worker tick
